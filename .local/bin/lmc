#!/bin/bash

set -euo pipefail

toggle-mic() {
	pamixer --default-source --toggle-mute
}

toggle-mute() {
	pamixer --toggle-mute
}

mute() {
	pamixer --mute
}

mute-mic() {
	pamixer --default-source --mute
}

unmute() {
	pamixer --unmute
}

up() {
	pamixer --increase "${1:-5}"
}

down() {
	pamixer --decrease "${1:-5}"
}

control() {
	pulsemixer
}

echo-help() {
	echo "Available commands:"
	declare -F | awk '!/ _.+$/ { print "・" $3; }'
}

_main() {
	local -r command=${1-}
	if declare -f -- "$command" >/dev/null && [[ $command != "${FUNCNAME[0]}" ]] && [[ $command != _* ]]; then
		# call arguments verbatim
		"$@"
	else
		notify-send \
			-u critical \
			"$(basename -- "$0")" \
			"Unsupported operation: ${1:-empty string}.\n\n$(echo-help)"
		exit 1
	fi

	# update volume block
	# see ~/.config/i3blocks/config
	pkill -RTMIN+10 "${STATUSBAR:-i3blocks}" &
}

_main "$@"
