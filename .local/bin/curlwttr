#!/bin/bash

set -euo pipefail

readonly result=$(curl -s \
	--max-time 10 \
	--compressed \
	-H "Accept-Language: ${LANG%_*}" \
	"https://wttr.in/$*" 2>/dev/null
)

if [[ -n $result ]] && ! [[ ${result,,} =~ failed|sorry|unknow|error|time-out|already\ being|not\ available ]]; then
	echo "$result"
else
	exit 1
fi
