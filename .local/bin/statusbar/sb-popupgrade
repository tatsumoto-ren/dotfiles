#!/bin/bash

set -euo pipefail

notify_pacman_i3_block() {
	pkill -RTMIN+8 "${STATUSBAR:-i3blocks}"
}

is_installed() {
    [[ -x "$(command -v "$1")" ]]
}

pac_upgrade() {
	# Pacman and AUR-helpers.
	if is_installed pacapt; then
		# On Ubuntu, pacapt can be used to upgrade system packages.
		# Snap is heavily utilized on Ubuntu. Upgrade snap packages as well.
		sudo pacapt -Syu
		sudo snap refresh
	elif pacman -Qq trizen >/dev/null; then
		trizen -Syu
	elif pacman -Qq paru >/dev/null; then
		paru -Syu
	else
		sudo pacman -Syu
	fi

	# Pacstall
	if is_installed pacstall; then
		pacstall -Up
	fi
}

pipx_upgrade() {
	if is_installed pipx; then
		pipx upgrade-all
	fi
}

main() {
	if ! is_installed pacapt; then
		archnews || exit 1
	fi

	echo "Beginning upgrade."
	pac_upgrade
	notify_pacman_i3_block
	remaps
	pipx_upgrade
	echo "Upgrade complete."

	if [ "$1" != "--no-wait" ]; then
		echo "Press <Enter> to exit window."
		read -r _
	fi
}

main "$@"
