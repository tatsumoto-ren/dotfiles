#!/bin/bash

set -euo pipefail

case ${BLOCK_BUTTON:-} in
1)
	notify-send "🖥 CPU hogs" "$(ps axch -o cmd:15,%cpu --sort=-%cpu | head)\\n(100% per core)"
	;;
3)
	i3-msg -q exec "i3-sensible-terminal -e htop"
	;;
6)
	i3-msg -q exec "i3-sensible-terminal -e ${EDITOR:-nvim} $0"
	;;
esac

# default values
readonly T_WARN="${T_WARN:-50}"
readonly T_CRIT="${T_CRIT:-80}"
readonly LABEL="${LABEL:-}"

# Get CPU usage from mpstat (100% - %idle).
# if mpstat is not run under en_US locale, things may break, so make sure it is
# $NF = number of fields = the last field = average idle
cpu_usage=$(LC_ALL="en_US.UTF-8" mpstat 1 1 | awk 'END { print 100 - $NF }')

if [[ -z "$cpu_usage" ]]; then
	echo "Can't find CPU information" >&2
	exit 1
fi

# Print full_text and short_text
formatted=$(printf -- '%s%s%.2f%%\n' "$LABEL" "${LABEL:+ }" "$cpu_usage")
printf -- '%s\n%s\n' "$formatted" "$formatted"

# Print color, if needed
cpu_int="${cpu_usage%.*}"
if (( cpu_int >= T_CRIT )); then
	printf -- '#FF0000\n'
	exit 33
elif (( cpu_int >= T_WARN )); then
	printf -- '#FFFC00\n'
else
	printf -- '#66CCFF\n'
fi
