#!/bin/bash

# This script is called on startup to remap keys,
# and re-run by remapd whenever a USB input device is plugged in.
# Xkb layout+options are managed by ~/.config/x11/keyboard_layouts.

# Map the caps lock key to super, and map the menu key to right super.
setxkbmap -option terminate:ctrl_alt_bksp,caps:super,altwin:menu_win,lv3:ralt_switch

# Map right Super key to Menu
xmodmap -e "keysym Super_R = Menu"

# 1. Power saving behaviour of monitors when the computer is not in use
# Disable screen saver blanking and set all the DPMS timeouts to zero.
# https://wiki.archlinux.org/index.php/Display_Power_Management_Signaling
#
# 2. Override LXDE keyboard/mouse settings
# Decrease key repeat delay to 300ms and increase key repeat rate to 50 per second.
#
# Mouse:	xset m accel_mult[/accel_div] [threshold]
# Autorepeat:	xset r rate delay [rate]
# TIP: The q option gives you information on the current settings.
xset \
	s off \
	dpms 0 0 0 \
	m 0 0 \
	r rate 300 50 \
	b off

# Caps = Super (set by ~/.config/x11/keyboard_layouts); tap = Escape via xcape
# When caps lock is pressed only once, treat it as escape.
killall xcape 2>/dev/null || true
xcape -e 'Super_L=Escape'

# Turn off caps lock if on since there is no longer a key for it.
if xset -q | grep -q "Caps Lock:\s*on"; then
	xdotool key Caps_Lock
fi
