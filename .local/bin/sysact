#!/bin/bash

# A dmenu wrapper script for system functions.

ctl() {
	case $(readlink -f /sbin/init) in
	*systemd*) echo systemctl ;;
	*) echo loginctl ;;
	esac
}

silence_all() {
	mpc pause || true
	pauseallmpv
	lmc mute
	lmc mute-mic
}

ask_action() {
	cat <<-EOF | dmenu -l 30 -i -p "Action:"
		🔒 lock screen
		🚪 leave ${WM:-i3}
		♻️ renew ${WM:-i3}
		🔃 reboot
		🖥️ shutdown
		💤 sleep
		🐻 hibernate
		📺 display off
	EOF
}

background_color() {
	{
		xrdb -query -all | awk -F'#' '/background:|color0:/{print $2; exit;}'
		echo 1d2021 # fallback
	} | head -1
}

display_off() {
	xset dpms force off
}

lock_screen() {
	fcitx-remote -s fcitx-keyboard-us-altgr-intl
	silence_all
	i3lock -e -f -c "${1:-$(background_color)}"
}

cleanup() {
	dmenurecord kill
	fcitx-remote -e
	ibus exit
	local -ra apps=(
		qbittorrent goldendict keepassxc telegram-desktop Throne simplex-desktop Telegram
	)
	for app in "${apps[@]}"; do
		killall "$app"
	done
	sleep '0.33s'
}

main() {
	sync
	case ${*:-$(ask_action)} in
	*lock*)
		lock_screen
		silence_all
		;;
	*leave*)
		cleanup
		i3-msg -q exit
		;;
	*renew*)
		i3-msg -q restart
		;;
	*hibernate*)
		lock_screen ee4b2b
		$(ctl) hibernate
		;;
	*sleep* | *suspend*)
		lock_screen ee4b2b
		$(ctl) suspend
		;;
	*reboot*)
		cleanup
		$(ctl) reboot -i
		;;
	*shutdown* | *poweroff*)
		cleanup
		$(ctl) poweroff -i
		;;
	*'display off'*)
		display_off
		;;
	*silence*)
		silence_all
		;;
	*)
		exit 1
		;;
	esac
}

main "$@"
