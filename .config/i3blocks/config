## i3blocks config file

# Global properties
command=~/.local/bin/statusbar/$BLOCK_NAME
separator_block_width=10
markup=none
full_text= 
align=left
color=#f3f4f5
separator=true
interval=5

[sb-music]
interval=10
signal=11
markup=pango

[sb-memory]
separator=false
interval=10

[sb-memory]
instance=swap
interval=15

[sb-disk]
instance=/home
interval=30

[sb-nettraf]
interval=5

[sb-cpu_usage]
LABEL=USE
interval=3
separator=false

[sb-cpu_freq]
interval=5

[sb-load_average]
interval=3

[sb-chiptemp]
chip_label=CPU
hwmon_label=CPUTIN
hwmon_name=nct6799
interval=7
separator=false

[sb-chiptemp]
chip_label=GPU
hwmon_name=amdgpu
hwmon_label=junction
interval=10

[sb-pacpackages]
interval=3600
signal=8

[sb-pulsevol]
signal=10
interval=10
separator=false

[sb-pulsevol]
signal=10
interval=10
instance=default-source

[sb-weather]
interval=1800
command=curlwttr "$LOCATION?format=1" || echo '±?°C'

[sb-calendar]
interval=30
separator=false

[sb-time]
command=date '+%H:%M'
interval=4
separator=false
separator_block_width=5

[sb-record]
command=cat /tmp/recordingicon 2>/dev/null || echo
interval=once
signal=9
background=#6d3d39
